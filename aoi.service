[Unit]
Description=AOI EtherCAT ROS2 System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin1
Group=admin1

# 资源限制 - 允许内存锁定（mlockall）
LimitMEMLOCK=infinity
LimitRTPRIO=99
LimitRTTIME=infinity

# 环境变量
Environment="HOME=/home/admin1"
Environment="ROS_DOMAIN_ID=0"
Environment="RCUTILS_CONSOLE_OUTPUT_FORMAT=[{time}] [{severity}]: {message}"
Environment="RCUTILS_TIME_OUTPUT_FORMAT=%Y-%m-%d %H:%M:%S"

# 工作目录
WorkingDirectory=/home/admin1/dev_ws

# 启动命令
ExecStart=/bin/bash /home/admin1/dev_ws/start_aoi_simple.sh

# 重启策略
Restart=on-failure
RestartSec=10
StartLimitInterval=60s
StartLimitBurst=3

# 日志输出
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aoi

[Install]
WantedBy=multi-user.target